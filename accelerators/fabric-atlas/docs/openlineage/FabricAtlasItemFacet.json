{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fredgis/FabricAtlas/main/docs/openlineage/FabricAtlasItemFacet.json",
  "$defs": {
    "FabricAtlasItemFacet": {
      "description": "Microsoft Fabric item behind an OpenLineage job or dataset, as exported by Fabric Atlas.",
      "allOf": [
        { "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/BaseFacet" },
        {
          "type": "object",
          "properties": {
            "platform": { "type": "string", "const": "MICROSOFT_FABRIC" },
            "itemType": { "type": "string", "description": "Fabric item type, e.g. Lakehouse, Warehouse, KQLDatabase, SemanticModel, Notebook, Eventstream." },
            "itemId": { "type": "string", "description": "Fabric item id." },
            "workspaceId": { "type": "string", "description": "Fabric workspace id." }
          },
          "required": ["platform", "itemType"]
        }
      ],
      "type": "object"
    }
  },
  "type": "object",
  "properties": {
    "fabricAtlas_item": { "$ref": "#/$defs/FabricAtlasItemFacet" }
  }
}
