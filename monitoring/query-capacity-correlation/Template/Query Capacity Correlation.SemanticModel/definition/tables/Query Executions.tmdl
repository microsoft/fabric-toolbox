/// Warehouse Query Insights executions from the configured Warehouse for the most recent 30 days. Each row represents one hourly window intersected by a submitted warehouse statement.
table 'Query Executions'
	lineageTag: d620ca99-60a5-4b8b-aba6-23d4004db51f

	/// Number of distinct Query Insights executions active in the current filter context.
	measure '# Queries' =
			VAR IsUnmatchedWindow =
			    ISINSCOPE('Hour Windows'[Timestamp])
			        && ISBLANK(SELECTEDVALUE('Hour Windows'[Timestamp]))
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			RETURN
			    IF(
			        IsUnmatchedWindow,
			        BLANK(),
			        COALESCE(
			            CALCULATE(
			                DISTINCTCOUNT('Query Executions'[Execution Key]),
			                TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			            ),
			            0
			        )
			    )
		formatString: #,##0
		displayFolder: Query Activity
		lineageTag: 2efaae1d-cfe6-4245-9a30-c6b125ebec58

	/// Number of query executions whose Query Insights status is Failed.
	measure '# Failed Queries' = COALESCE(CALCULATE([# Queries], KEEPFILTERS('Query Executions'[Query Status] = "Failed")), 0)
		formatString: #,##0
		displayFolder: Query Activity
		lineageTag: c11f2ea1-0e15-4358-8166-f6863bc2b1ea

	/// Share of query executions whose Query Insights status is Failed.
	measure 'Failure Rate' = COALESCE(DIVIDE([# Failed Queries], [# Queries]), 0)
		formatString: 0.00%
		displayFolder: Query Activity
		lineageTag: 2f14fdd9-c580-4562-a31e-6253a15de818

	/// Total elapsed query duration converted from milliseconds to seconds.
	measure 'Total Duration (s)' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR SelectedExecutions =
			    CALCULATETABLE(
			        VALUES('Query Executions'[Execution Key]),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    DIVIDE(
			        SUMX(
			            SelectedExecutions,
			            CALCULATE(MAX('Query Executions'[Duration (ms)]))
			        ),
			        1000
			    )
		formatString: #,##0.00
		displayFolder: Performance
		lineageTag: 2306ae0c-9602-42e9-8744-18af70be6048

	/// Average elapsed query duration converted from milliseconds to seconds.
	measure 'Average Duration (s)' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR SelectedExecutions =
			    CALCULATETABLE(
			        VALUES('Query Executions'[Execution Key]),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    COALESCE(
			        DIVIDE(
			            AVERAGEX(
			                SelectedExecutions,
			                CALCULATE(MAX('Query Executions'[Duration (ms)]))
			            ),
			            1000
			        ),
			        0
			    )
		formatString: #,##0.00
		displayFolder: Performance
		lineageTag: b76507f5-27f8-462f-89dd-c992bfe36d9d

	/// 95th percentile of elapsed query duration in seconds.
	measure 'P95 Duration (s)' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR SelectedExecutions =
			    CALCULATETABLE(
			        VALUES('Query Executions'[Execution Key]),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    COALESCE(
			        DIVIDE(
			            PERCENTILEX.INC(
			                SelectedExecutions,
			                CALCULATE(MAX('Query Executions'[Duration (ms)])),
			                0.95
			            ),
			            1000
			        ),
			        0
			    )
		formatString: #,##0.00
		displayFolder: Performance
		lineageTag: 04949451-5188-4d86-9c52-17d90bf28528

	/// Total allocated query CPU time converted from milliseconds to seconds.
	measure 'Total CPU Time (s)' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR SelectedExecutions =
			    CALCULATETABLE(
			        VALUES('Query Executions'[Execution Key]),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    DIVIDE(
			        SUMX(
			            SelectedExecutions,
			            CALCULATE(MAX('Query Executions'[CPU Time (ms)]))
			        ),
			        1000
			    )
		formatString: #,##0.00
		displayFolder: Performance
		lineageTag: b38d6096-7359-48f0-9867-c97613067b56

	/// Total megabytes scanned across remote storage, memory, and disk.
	measure 'Total Data Scanned (MB)' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR SelectedExecutions =
			    CALCULATETABLE(
			        VALUES('Query Executions'[Execution Key]),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    SUMX(
			        SelectedExecutions,
			        CALCULATE(
			            MAX('Query Executions'[Remote Storage Scanned (MB)])
			                + MAX('Query Executions'[Memory Scanned (MB)])
			                + MAX('Query Executions'[Disk Scanned (MB)])
			        )
			    )
		formatString: #,##0.00
		displayFolder: Performance
		lineageTag: 7c0bbc8c-68d6-4a43-bbcf-f8e1768721e8

	/// Average Capacity Metrics utilization across the selected hourly range.
	measure 'Capacity Utilization' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			RETURN
			    CALCULATE(
			        AVERAGE('Capacity Hour'[Average CU %]),
			        TREATAS(SelectedHours, 'Capacity Hour'[Timestamp])
			    )
		formatString: 0.00%
		displayFolder: Correlation
		lineageTag: e1ece2a7-ee88-4b81-931d-44b9700587a2

	/// Returns one when the current execution overlaps at least one selected hour.
	measure 'Is Active In Selected Range' =
			VAR SelectedHours = VALUES('Hour Windows'[Timestamp])
			VAR MatchingRows =
			    CALCULATE(
			        COUNTROWS('Query Executions'),
			        TREATAS(SelectedHours, 'Query Executions'[Query Hour])
			    )
			RETURN
			    IF(MatchingRows > 0, 1, 0)
		formatString: 0
		isHidden
		lineageTag: c4e7a456-e04f-488b-ae45-78584d022cb6

	/// Query Insights identifier for an individual distributed statement. This value isn't a Capacity Metrics operation identifier.
