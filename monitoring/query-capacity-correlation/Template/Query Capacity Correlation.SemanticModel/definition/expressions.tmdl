expression 'DirectQuery to AS - Fabric Capacity Metrics' =
		let
		    Source = AnalysisServices.Database("{{CAPACITY_METRICS_ENDPOINT}}", "{{CAPACITY_METRICS_MODEL}}"),
		    Cubes = Table.Combine(Source[Data]),
