	/// Technical identifier of the quota returned by the Azure API (for example CapacityQuota, OneLake or DataWarehouse). Empty for the data collected by FCA versions before 2026.11.26, which did not store the quota name.
	column QuotaId
		dataType: string
		isHidden
		sourceProviderType: varchar(8000)
		lineageTag: ef6903a7-db75-4fe6-9d8e-9bb02a087070
		sourceLineageTag: QuotaId
		summarizeBy: none
		sourceColumn: QuotaId

		annotation SummarizationSetBy = Automatic

	/// Name of the quota as displayed in the Azure portal (Quotas > Microsoft Fabric), for example "CapacityQuota", "On-demand enabled capacities" or "Data Warehouse On-demand CU hours per day".
	column QuotaName
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: b4f005fb-6778-416b-a4ae-835fc72f8751
		sourceLineageTag: QuotaName
		summarizeBy: none
		sourceColumn: QuotaName

		annotation SummarizationSetBy = Automatic

	/// Unit of the usage and limit of the quota: CU (capacity units), CUhrs (CU hours per day) or Count (number of capacities).
	column Unit
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 78601594-0f79-4f2b-8801-da6cac8a45b6
		sourceLineageTag: Unit
		summarizeBy: none
		sourceColumn: Unit

		annotation SummarizationSetBy = Automatic

